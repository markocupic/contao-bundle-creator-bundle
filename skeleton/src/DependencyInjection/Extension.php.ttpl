<?php

declare(strict_types=1);

{{ phpdoc }}

namespace {{ toplevelnamespace }}\{{ sublevelnamespace }}\DependencyInjection;

use Symfony\Component\Config\FileLocator;
use Symfony\Component\DependencyInjection\ContainerBuilder;
use Symfony\Component\DependencyInjection\Extension\Extension;
use Symfony\Component\DependencyInjection\Loader\YamlFileLoader;

class {{ dependencyinjectionextensionclassname }} extends Extension
{
{% if addFriendlyConfiguration %}
    public function getAlias(): string
    {
        return Configuration::ROOT_KEY;
    }

{% endif %}
    /**
     * @throws \Exception
     */
    public function load(array $configs, ContainerBuilder $container): void
    {
{% if addFriendlyConfiguration %}
        $configuration = new Configuration();

        $config = $this->processConfiguration($configuration, $configs);
{% endif %}

        $loader = new YamlFileLoader(
            $container,
            new FileLocator(__DIR__.'/../../config'),
        );

        $loader->load('parameters.yaml');
        $loader->load('services.yaml');
        $loader->load('listener.yaml');
{% if addFriendlyConfiguration %}
        $rootKey = $this->getAlias();

        $container->setParameter($rootKey.'.foo.bar', $config['foo']['bar']);
{% endif %}
    }
}
