<?php

declare(strict_types=1);

{{ phpdoc }}

namespace {{ toplevelnamespace }}\{{ sublevelnamespace }}\DependencyInjection\Compiler;

use Symfony\Component\DependencyInjection\Compiler\CompilerPassInterface;
use Symfony\Component\DependencyInjection\ContainerBuilder;
use Symfony\Component\DependencyInjection\Reference;

/**
 * @internal
 */
class AddSessionBagsPass implements CompilerPassInterface
{
    public function process(ContainerBuilder $container): void
    {
        if (!$container->has('session')) {
            return;
        }

        $session = $container->findDefinition('session');
        $session->addMethodCall('registerBag', [new Reference('{{ toplevelnamespace }}\{{ sublevelnamespace }}\Session\Attribute\ArrayAttributeBag')]);
    }
}
