<?php

declare(strict_types=1);

{{ phpdoc }}

namespace {{ toplevelnamespace }}\{{ sublevelnamespace }}\ContaoManager;

use {{ toplevelnamespace }}\{{ sublevelnamespace }}\{{ toplevelnamespace }}{{ sublevelnamespace }};
use Contao\CoreBundle\ContaoCoreBundle;
use Contao\ManagerPlugin\Bundle\BundlePluginInterface;
use Contao\ManagerPlugin\Bundle\Config\BundleConfig;
use Contao\ManagerPlugin\Bundle\Parser\ParserInterface;
{% if addCustomRoute %}
use Contao\ManagerPlugin\Routing\RoutingPluginInterface;
use Symfony\Component\Config\Loader\LoaderResolverInterface;
use Symfony\Component\HttpKernel\KernelInterface;
use Symfony\Component\Routing\RouteCollection;
{% endif %}

class Plugin implements BundlePluginInterface{% if addCustomRoute|default %}, RoutingPluginInterface{{ '\n' }}{% endif %}
{
    public function getBundles(ParserInterface $parser): array
    {
        return [
            BundleConfig::create({{ toplevelnamespace }}{{ sublevelnamespace }}::class)
                ->setLoadAfter([ContaoCoreBundle::class]),
        ];
    }
{% if addCustomRoute %}

    /**
     * @return RouteCollection|null
     */
    public function getRouteCollection(LoaderResolverInterface $resolver, KernelInterface $kernel)
    {
        return $resolver
            ->resolve(__DIR__.'/../Controller')
            ->load(__DIR__.'/../Controller')
        ;
    }
{% endif %}
}
