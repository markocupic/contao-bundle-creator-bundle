# config/services.yaml
services:
    _defaults:
        autowire: true          # Automatically injects dependencies in your services.
        autoconfigure: true     # Automatically registers your services as commands, event subscribers, etc.
        public: false           # Allows optimizing the container by removing unused services; this also means
                                # fetching services directly from the container via $container->get() won't work.
                                # The best practice is to be explicit about your dependencies anyway.
        bind:
            #$projectDir: '%kernel.project_dir%'

    {{ toplevelnamespace }}\{{ sublevelnamespace }}\:
        resource: ../src/
        exclude: ../src/{DependencyInjection,Model,Session}

  {% if addSessionAttribute|default %}
    # Add a session bag
    {{ servicevendornamekey }}.{{ servicerepositorynamekey }}.session.factory:
        class: {{ toplevelnamespace }}\{{ sublevelnamespace }}\Session\SessionFactory
        decorates: session.factory
        arguments:
            - '@{{ servicevendornamekey }}.{{ servicerepositorynamekey }}.session.factory.inner'
            - '@{{ servicevendornamekey }}.{{ servicerepositorynamekey }}.session.attribute.array_attribute_bag'

    {{ servicevendornamekey }}.{{ servicerepositorynamekey }}.session.attribute.array_attribute_bag:
        class: {{ toplevelnamespace }}\{{ sublevelnamespace }}\Session\Attribute\ArrayAttributeBag
        arguments:
            - {{ sessionAttributeKey }}
        calls:
            - [ setName, [ {{ sessionAttributeName }} ] ]
  {% endif %}
