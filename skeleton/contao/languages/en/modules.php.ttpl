 * Frontend modules
 */
{% if frontendmodulecategorytrans|default %}
$GLOBALS['TL_LANG']['FMD']['{{ frontendmodulecategory }}'] = '{{ frontendmodulecategorytrans }}';
{% endif %}
$GLOBALS['TL_LANG']['FMD'][{{ frontendmoduleclassname }}::TYPE] = ['{{ frontendmoduletrans_0 }}', '{{ frontendmoduletrans_1 }}'];
{% endif %}
