{
    "name": "markocupic/contao-bundle-creator-bundle",
    "description": "This bundle provides a bundle maker for Contao 5.3 and Contao 6. The extension will create a fully working backend- or/and frontend module after you have defined a few parameters in the Contao backend.",
    "keywords": [
        "contao",
        "bundle",
        "maker",
        "creator",
        "extension",
        "boilerplate",
        "skeleton"
    ],
    "type": "contao-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Marko Cupic",
            "email": "m.cupic@gmx.ch",
            "homepage": "https://github.com/markocupic",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/markocupic/contao-bundle-creator-bundle/issues",
        "source": "https://github.com/markocupic/contao-bundle-creator-bundle"
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "contao/core-bundle": "^5.3 || ^6.0",
        "markocupic/zip-bundle": "^1.2",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/event-dispatcher": "^6.4 || ^7.0 || ^8.0",
        "symfony/event-dispatcher-contracts": "^3.0",
        "symfony/filesystem": "^6.4 || ^7.0 || ^8.0",
        "symfony/finder": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0",
        "twig/twig": "^3.8"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.12",
        "contao/test-case": "^5.3 || ^6.0"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "Markocupic\\ContaoBundleCreatorBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markocupic\\ContaoBundleCreatorBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Markocupic\\ContaoBundleCreatorBundle\\ContaoManager\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "contao/manager-plugin": false,
            "contao-components/installer": false,
            "php-http/discovery": false,
            "contao-community-alliance/composer-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "policy": {
            "advisories": {
                "ignore-id": [
                    "PKSA-8j6w-3kr7-s9xk",
                    "PKSA-6j95-1jtb-x6wc",
                    "PKSA-cbx2-m9db-bmzd"
                ]
            }
        }
    },
    "scripts": {
        "cs-fixer": "@php tools/ecs/vendor/bin/ecs check config/ src/ tests/ --config tools/ecs/config/default.php --fix --ansi",
        "phpstan": "@php tools/phpstan/vendor/bin/phpstan analyse src tests",
        "unit-tests": "@php vendor/bin/phpunit --colors=always"
    }
}
